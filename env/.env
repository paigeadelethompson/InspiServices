# InspiServices environment (config + secrets). Copy to .env and fill in.
# Loaded via load_env_file(): lives in ./ .env (or SERVICES_ENV_FILE, or --env).
# Comments start with '#' or ';'. Simple KEY=value; optional quotes are stripped.
# Real shell environment wins over entries in this file.
# All networking config lives here -- there is no seed .conf file.

# --- debug logging -------------------------------------------------------
# Turn on verbose IRC/debug output: 1/true/on or 0/false/off
SERVICES_DEBUG=1

# --- server identity ------------------------------------------------------
# This daemon's name and 3-char SID on the spanning tree (first char digit).
SERVER_NAME=services.netcrave.chat
SERVER_SID=8E0
SERVER_DESC=netcrave.chat services

# --- upstream InspIRCd hub link -------------------------------------------
# Where to dial, and the <link> credentials matching the hub side.
HUB_HOST=[2001:470:b:56f:30:5::]
HUB_PORT=6000
HUB_TLS=1
LINK_SENDPASS=changeme
LINK_RECVPASS=changeme
#    (equivalently: SERVICES_LINK_SENDPASS / SERVICES_LINK_RECVPASS)

# --- uplink auto-reconnect ---------------------------------------------------
# When the link drops (peer FIN, ERROR, timeout), retry with exponential
# backoff from LINK_RETRY_MIN up to LINK_RETRY_MAX (seconds). Reboots once it
# is back up. Set LINK_RETRY=0 to only try once at startup.
LINK_RETRY=1
LINK_RETRY_MIN=5
LINK_RETRY_MAX=300

# --- service (bot) identity ------------------------------------------------
# Each pseudo-user can override its client nick, host, ident and gecos.
# Names are <NAME>_NICK/_HOST/_IDENT/_GECOS, optionally SERVICES_ prefixed.
# Defaults: NickServ, ChanServ, BotServ, OperServ, BridgeServ @ services.answer.
NICKSERV_NICK=NICKSERV
NICKSERV_HOST=services/netcrave
CHANSERV_NICK=CHANSERV
CHANSERV_HOST=services/netcrave
BOTSERV_HOST=services/netcrave
BOTSERV_NICK=BOTSERV
OPERSERV_NICK=OPERSERV
OPERSERV_HOST=services/netcrave
BRIDGESERV_NICK=BRIDGESERV
BRIDGESERV_HOST=services/netcrave
